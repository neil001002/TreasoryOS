# ─── Network selector ────────────────────────────────────────────────────────
# Set to 'testnet' (default) or 'mainnet'.
# Flips chain ID, RPC, explorer URL, USDC address, and contract address.
VITE_ARC_NETWORK=testnet

# ─── TreasurySplitter contract addresses ─────────────────────────────────────
# Arc Testnet deployment (legacy single-user contract — used as fallback)
VITE_TREASURY_SPLITTER_TESTNET=0x17ba9334e74b537ed0729b829331719dd2039d3d

# Arc Mainnet deployment — fill in after running `forge create` locally
VITE_TREASURY_SPLITTER_MAINNET=

# ─── TreasurySplitterFactory contract addresses ───────────────────────────────
# Multi-user factory — any wallet calls createTreasury() to deploy their own instance.
# Arc Testnet factory (deployed by Arc Studio)
VITE_TREASURY_FACTORY_TESTNET=0xb7d1b52aecb53ad2d864e5e394be06fe097d8b0e

# Arc Mainnet factory — deploy from your own wallet: forge create TreasurySplitterFactory
# --constructor-args "0x3600000000000000000000000000000000000000"
VITE_TREASURY_FACTORY_MAINNET=

# ─── WalletConnect ───────────────────────────────────────────────────────────
# Free project ID from https://cloud.walletconnect.com
# Required for MetaMask Mobile, Trust Wallet, Rainbow, etc.
VITE_WC_PROJECT_ID=

# ─── Circle Modular Wallets (passkey) ────────────────────────────────────────
# Get from Circle Console → Keys → Client Keys (starts with TEST_CLIENT_KEY:)
# Also set Allowed Domain + Passkey Domain Name in Console to your app URL.
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://api.circle.com

# ─── Public app URL ──────────────────────────────────────────────────────────
# Used to build shareable payment links. Set to your Vercel URL.
VITE_APP_URL=https://your-app.vercel.app

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to 'false' to hide a feature from the dashboard. Defaults to enabled.
VITE_FEATURE_CCTP=true
VITE_FEATURE_STABLEFX=true
