# Copy this file to .env and fill in your values.
# Vite exposes any variable prefixed with VITE_ to the browser.

# -----------------------------------------------------------------------
# Arc chain selection
# 5042002 = Arc Testnet (safe for development, free testnet USDC)
# 5042    = Arc Mainnet (REAL funds — deploy and review carefully first)
# -----------------------------------------------------------------------
VITE_ARC_CHAIN_ID=5042002

# TreasurySplitter contract address for the ACTIVE chain above.
# Leave empty until you have deployed; the app shows a setup prompt.
VITE_TREASURY_SPLITTER_ADDRESS=

# Keep the testnet deployment for reference while running on mainnet.
VITE_TREASURY_SPLITTER_TESTNET_ADDRESS=0xa90bcefa574a78af25528191fef7e97471e5ca95

# Optional: RPC proxy (provisioned by Arc Studio automatically inside Arc Studio)
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
